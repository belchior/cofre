{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cofre",
  "identifier": "com.belchior.cofre",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cofre",
        "width": 380,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "homepage": "https://github.com/belchior/cofre#readme",
    "category": "Utility",
    "shortDescription": "Cofre - Uma Prova de Conceito",
    "longDescription": "App para guardar senhas",
    "publisher": "Belchior Oliveira",
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
